{
  "name": "Signifi Lane Tester",
  "short_name": "Lane Tester",
  "description": "Jofemar Qendra lane tester for Signifi Spark XL and Companion kiosks",
  "id": "./app/",
  "start_url": "./app/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "background_color": "#f3f4f6",
  "theme_color": "#1f2121",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ]
}
